{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaulty",
  "version": "0.0.1",
  "identifier": "dev.vaulty.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vaulty",
        "width": 960,
        "height": 680,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "popup",
        "title": "Vaulty Capture",
        "url": "popup",
        "width": 520,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "A local-first secrets vault",
    "longDescription": "Select text anywhere, press the shortcut, give it a label - encrypted on disk.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "providerShortName": null
    }
  }
}